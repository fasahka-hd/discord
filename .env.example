# Server
NODE_ENV=production
PORT=3001

# Generate a long random secret (32+ characters)
DSH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Set to true only when you explicitly want demo data created
DSH_SEED_DEMO=false

# Set true when the app is behind one trusted reverse proxy (for example Nginx)
TRUST_PROXY=true
